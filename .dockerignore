target/
.git/
.github/
.idea/
.vscode/
.superpowers/
legacy-go/
# Match nested node_modules too (e.g. crates/.../dashboard/web/node_modules).
# Without **/ the host's macOS-built node_modules leaks into the Docker
# build context and bun install --frozen-lockfile sees it as already-
# satisfied, leaving wrong-platform binaries behind that blow up at
# nuxt generate time. Reproduces only on `just dev`; CI is always fresh.
**/node_modules/

# design/ stays IN the build context: the dashboard's Vite/PostCSS imports
# design/tokens.css from web/. Excluding it broke `bun run build` inside Docker.
**/.DS_Store
**/.nuxt/
**/.output/
**/.bun/
**/dist/

# docs/, skills/, and crates/<crate>/docs/*.md stay IN the build context.
# isengard-mcp bakes them into the binary at compile time via
# include_dir!; excluding them panics the proc macro during cargo build
# release. The Docus site under website/ is not consumed by the binary
# and would only bloat the build context, so keep it ignored.
website/
