# Isengard production environment.
#
# This file is written to /etc/isengard/isengard.env by install/install.sh on
# first run, then loaded by docker compose at every up/restart. Edit it in
# place; install.sh will NOT overwrite an existing file.
#
# Lines that start with `#` are comments. Don't quote values unless they
# contain spaces; docker compose --env-file follows POSIX shell-style parsing
# and `KEY=value` is the safe form.
#
# After editing, restart the stack:
#   docker compose --env-file /etc/isengard/isengard.env \
#     -f /etc/isengard/compose.yaml up -d
#
# Or just re-run install/install.sh; it picks up changes idempotently.

# ---------------------------------------------------------------------------
# Image tag (optional)
# ---------------------------------------------------------------------------
# Pin to a tagged release for reproducibility once we ship one. Default is
# `next` (rolling). Examples: `v0.3.5`, `sha-abc1234`, or a digest like
# `next@sha256:...`.
#
# ISENGARD_IMAGE_TAG=next

# ---------------------------------------------------------------------------
# State path (optional)
# ---------------------------------------------------------------------------
# Where bind-mounted state lives on the host. Defaults to /var/lib/isengard.
# install.sh creates ${ISENGARD_PREFIX}/{controller,agent,stacks} on first
# run. Move it to a backed-up filesystem if you have one.
#
# ISENGARD_PREFIX=/var/lib/isengard

# ---------------------------------------------------------------------------
# Bind addresses (optional)
# ---------------------------------------------------------------------------
# Production binds the controller's gRPC + dashboard to host loopback by
# default. Front them with a Cloudflare Tunnel or reverse proxy for remote
# access; only change these if you know exactly what you're exposing.
#
# ISENGARD_CONTROLLER_GRPC_BIND=127.0.0.1
# ISENGARD_CONTROLLER_HTTP_BIND=127.0.0.1
# ISENGARD_CONTROLLER_DNS_BIND=127.0.0.1
#
# The pingora proxy publishes on all interfaces by default since that's the
# whole point of a reverse proxy. Restrict to one interface if multi-homed.
#
# ISENGARD_PROXY_BIND=0.0.0.0

# ---------------------------------------------------------------------------
# Docker socket (optional, only for non-standard runtimes)
# ---------------------------------------------------------------------------
# The agent bind-mounts the host docker.sock so it can manage containers
# running outside its own compose project. Default works for Docker Desktop
# and vanilla Linux. Override only if you're on a non-Desktop Mac runtime.
#   OrbStack:        $HOME/.orbstack/run/docker.sock
#   Colima:          $HOME/.colima/default/docker.sock
#   Rancher Desktop: $HOME/.rd/docker.sock
#
# DOCKER_SOCK=/var/run/docker.sock

# ---------------------------------------------------------------------------
# Logging (optional)
# ---------------------------------------------------------------------------
# Default: info. Switch to `warn` for quieter steady-state, or
# `debug,h2=info,hyper=info` for short-term troubleshooting.
#
# RUST_LOG=info

# ---------------------------------------------------------------------------
# DNS resolver (optional, v0.3b)
# ---------------------------------------------------------------------------
# Empty disables the resolver. Set to a zone name (e.g. `iso`, `weavers`,
# `lan`) to expose <host>.<zone> resolution on UDP 5300. See docker/README.md
# "DNS resolver" section for client config.
#
# ISENGARD_DNS_ZONE=

# ---------------------------------------------------------------------------
# ACME / TLS (REQUIRED for public HTTPS routing rules)
# ---------------------------------------------------------------------------
# Email used as the ACME contact when the agent requests certs from Let's
# Encrypt. Required if you publish any public HTTPS routing rule; safe to
# leave unset for purely-internal deployments.
#
# ISENGARD_ACME_EMAIL=ops@example.com

# ACME directory URL. Defaults to Let's Encrypt staging (the agent's safe
# default until production validation is verified). Switch to production
# only after a successful staging issue:
#   https://acme-v02.api.letsencrypt.org/directory
#
# ISENGARD_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory

# Comma-separated list of hostnames for which the agent should pre-issue
# certs on startup. Wildcards (`*.example.com`) require DNS-01 (see
# ISENGARD_CF_DNS_API_TOKEN below). Leave empty to issue lazily on the first
# request that matches a routing rule.
#
# ISENGARD_ACME_DOMAINS=

# Cloudflare API token with `Zone:DNS:Edit` for the zones in
# ISENGARD_ACME_DOMAINS. Required ONLY for DNS-01 (wildcard certs or domains
# you can't expose to the public internet on port 80). HTTP-01 uses port 80
# and needs no token.
#
# ISENGARD_CF_DNS_API_TOKEN=

# ---------------------------------------------------------------------------
# Secrets passphrase (REQUIRED if you store stack secrets via the dashboard)
# ---------------------------------------------------------------------------
# Symmetric passphrase used to encrypt at-rest secrets in the controller's
# sqlite store. Pick a long random value (>= 32 chars). Losing it means
# losing every stored secret. Back it up out-of-band.
#
# ISENGARD_SECRETS_PASSPHRASE=

# ---------------------------------------------------------------------------
# Backup passphrase (REQUIRED for encrypted backups)
# ---------------------------------------------------------------------------
# Passphrase used by the backup plugin to encrypt snapshot tarballs before
# upload. Same rules as above: long, random, backed up separately.
#
# ISENGARD_BACKUP_PASSPHRASE=

# ---------------------------------------------------------------------------
# Enrollment token (transient, optional)
# ---------------------------------------------------------------------------
# Mint with:
#   docker exec iso-controller isengard controller token mint --role agent
# Paste the token here ONLY if you want the agent to enroll on the next
# `compose up`. After successful enrollment the agent persists its mTLS
# cert and the token can (and should) be removed from this file.
#
# ISENGARD_ENROLL_TOKEN=
