# Isengard controller (Phase 0.8 systemd-native install).
#
# Runs the controller binary directly from /usr/local/bin/isengard. No
# docker, no compose, no socket. The controller persists its CA, SQLite,
# and certs under /var/lib/isengard (the StateDirectory below).
#
# Bring up via:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now iso-controller.service
#
# Followed by iso-agent.service once the controller is healthy and a
# bootstrap token has been minted. install/install.sh handles both.
#
# This unit is paired with install/systemd/iso-agent.service. The agent
# unit's Wants= + After= chain makes the agent restart when this unit
# restarts (PartOf= on the agent side).

[Unit]
Description=Isengard Controller
Documentation=https://github.com/Weavers-Engineering/Isengard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/isengard controller --state-dir /var/lib/isengard
Restart=on-failure
RestartSec=5

# Non-secret config (ACME email, domains, directory) is generated by
# install.sh. master-key.env is optional: when present it points
# ISENGARD_MASTER_KEY_FILE at /etc/isengard/master.key. The leading
# `-` makes it tolerate a missing file (older installs lacked it).
EnvironmentFile=/etc/isengard/isengard.env
EnvironmentFile=-/etc/isengard/master-key.env

# Run as root for Phase 0.8: the controller reads /etc/isengard/master.key
# (mode 0600 root) on boot and binds to :9417/:9418/:5300. Phase 0.10+
# tightens this to a dedicated user with explicit Capabilities= +
# AmbientCapabilities= for the privileged ports.
User=root
Group=root

# Hardening: the controller only writes under /var/lib/isengard and
# /etc/isengard. Everything else is read-only or invisible to the
# process. systemd sets these up automatically:
#   StateDirectory      -> /var/lib/isengard (mode 0755 root by default)
#   ConfigurationDirectory -> /etc/isengard (already exists, install.sh)
#   LogsDirectory       -> /var/log/isengard (created on first boot)
StateDirectory=isengard
ConfigurationDirectory=isengard
LogsDirectory=isengard
ReadWritePaths=/var/lib/isengard /etc/isengard
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

# Clean shutdown contract (paired with isengard update's graceful_replace
# in crates/isengard-agent/src/self_update.rs):
#
#   1. systemctl stop sends SIGTERM (KillSignal=).
#   2. Controller catches SIGTERM, flushes pending SQLite writes, drops
#      its gRPC + HTTP listeners.
#   3. If the process is still alive after TimeoutStopSec, KillMode=mixed
#      sends SIGKILL to the main process plus everything in the cgroup.
#   4. isengard update then waits for ActiveState=inactive and probes
#      the listener ports before issuing the new systemctl start.
#
# 15s is short enough to keep `isengard update` snappy and long enough
# for the controller's flush + tonic server shutdown. After
# TimeoutStopSec, systemd's default SendSIGKILL=yes finishes the
# job by sending SIGKILL to whatever remains in the cgroup.
TimeoutStopSec=15s
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
