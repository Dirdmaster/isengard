# Isengard agent (Phase 0.8 systemd-native install).
#
# Runs the agent binary directly from /usr/local/bin/isengard. The agent
# uses wisp (clone3 + cgroup v2 + iptables) to manage workload containers,
# so this unit deliberately does NOT depend on dockerd. The bind to /var
# is a host path for wisp's content store + bundles.
#
# Bring up via:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now iso-agent.service
#
# install/install.sh chains controller -> token mint -> CA export -> agent.
# Run that instead of touching this directly on a fresh host.
#
# PartOf=iso-controller.service so a controller restart cycles us as well:
# the agent's enrollment cert is bound to the running controller's CA, and
# fresh CAs need a fresh agent handshake.

[Unit]
Description=Isengard Agent
Documentation=https://github.com/Weavers-Engineering/Isengard
After=network-online.target iso-controller.service
Wants=network-online.target
PartOf=iso-controller.service

[Service]
Type=simple
ExecStart=/usr/local/bin/isengard agent --controller https://localhost:9417 --state-dir /var/lib/isengard/agent
Restart=on-failure
RestartSec=5

# Three env files:
#   isengard.env       non-secret config (ACME, RUST_LOG, ...)
#   agent-token.env    transient enrollment token (deleted after first enroll)
#   master-key.env     optional, sets ISENGARD_MASTER_KEY_FILE on the agent
#
# The leading `-` on the master-key path tolerates a missing file (the
# agent doesn't read the master key today; reserved for future use).
EnvironmentFile=/etc/isengard/isengard.env
EnvironmentFile=/etc/isengard/agent-token.env
EnvironmentFile=-/etc/isengard/master-key.env

# Wisp needs broad kernel privileges. Phase 0.8 runs the agent as root
# with no AppArmor / SELinux profile. Required caps (held implicitly via
# root for now; the cap-set tighten lands in Phase 0.10 alongside an
# AppArmor profile):
#
#   SYS_ADMIN    mount(2), pivot_root, namespace ops for clone3
#   NET_ADMIN    iptables, bridge, veth, sysctl net.ipv4.*
#   SYS_PTRACE   /proc/<pid>/ns/* access for nsenter healthchecks
#   SYS_RESOURCE cgroup v2 writes outside the agent's own slice
#   CHOWN, SETUID, SETGID, DAC_OVERRIDE, FOWNER, SETPCAP
#                workload bootstrap (nginx-style images that drop privs)
User=root
Group=root

# The agent writes to:
#   /var/lib/wisp           wisp host-side state (CLI inspection)
#   /var/lib/isengard/agent agent state, bundles, content store
#   /sys/fs/cgroup          cgroup v2 mkdir for per-container slices
#   /etc/isengard/stacks    per-stack compose.yaml (compose-as-truth)
ReadWritePaths=/var/lib/wisp /var/lib/isengard /sys/fs/cgroup /etc/isengard

# `strict` would block /sys/fs/cgroup writes; relax to `full` so /usr +
# /boot + /efi stay read-only but /sys/fs/cgroup writes go through.
ProtectSystem=full

# Wisp does its own per-container cap drops + setuid; setting
# NoNewPrivileges=true would prevent that. PrivateTmp=false because
# the agent manages tmpfs mounts for /run/secrets per workload.
NoNewPrivileges=false
PrivateTmp=false

# StateDirectory= would chmod 0755 the parent; the agent state dir is
# nested under /var/lib/isengard/agent and managed by install.sh.
# Leave it out so we don't fight the controller's StateDirectory=.

# Clean shutdown contract (paired with isengard update's graceful_replace
# in crates/isengard-agent/src/self_update.rs):
#
#   1. systemctl stop sends SIGTERM (KillSignal=).
#   2. Pingora drops its listener within milliseconds and starts a 10s
#      grace_period_seconds window for in-flight requests
#      (configured in crates/isengard-agent/src/proxy/server.rs).
#   3. If the process is still alive after TimeoutStopSec, KillMode=mixed
#      sends SIGKILL to the main process plus everything in the cgroup.
#   4. isengard update then waits for ActiveState=inactive and probes
#      the listener ports before issuing the new systemctl start.
#
# 15s is short enough to keep `isengard update` snappy and long enough
# for the agent's regular flush (wisp state + close compose watcher).
# After TimeoutStopSec, systemd's default SendSIGKILL=yes finishes the
# job by sending SIGKILL to whatever remains in the cgroup.
TimeoutStopSec=15s
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
